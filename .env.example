# Secretos (NO commitear .env real)

PG_PASSWORD=replace_me
MSSQL_PASSWORD=replace_me
# Solo es necesario para pipelines que consumen Ucampus.
UCAMPUS_TOKEN=replace_me

# Overrides no secretos. Son opcionales en desarrollo y obligatorios cuando
# config/prod.yml no fija el valor correspondiente.
# APP_LOG_LEVEL=INFO
# APP_LOG_FORMAT=json
# PG_HOST=localhost
# PG_PORT=5432
# PG_DB=etl
# PG_USER=etl
# MSSQL_HOST=sqlserver.local
# MSSQL_PORT=1433
# MSSQL_DB=origen
# MSSQL_USER=etl_reader
# MSSQL_DRIVER=ODBC Driver 18 for SQL Server
# UCAMPUS_BASE_URL=https://ucampus.example/api/
# UCAMPUS_TIMEOUT_S=30
